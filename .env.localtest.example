# Local testing only: a full Compose stack against a real, small model,
# with Tavily and Moltbook stubbed so nothing paid or public is ever
# touched. See docs/operations.md, "Local testing against a small model".
#
# Copy to .env.localtest, then:
#   docker compose --env-file .env.localtest --profile localtest up -d
#   scripts/localtest-smoke.sh
#
# These passwords and keys are only ever seen by containers on this one
# throwaway stack; they do not need to be secret, just present.
# A different, unusual host port, so this throwaway stack never collides
# with a normal dev `db` (5432) or another project's own Postgres (5433
# is also a common default to pick as "the other one").
COLLEGIUM_DB_PORT=55432

POSTGRES_PASSWORD=localtest
COLLEGIUM_WORKER_PASSWORD=localtest
COLLEGIUM_BOARD_PASSWORD=localtest
COLLEGIUM_PUBLISHER_PASSWORD=localtest

# The real small model, served by the `llm` service (the localtest profile).
COLLEGIUM_LLM_BASE_URL=http://llm:8080/v1
COLLEGIUM_LLM_MODEL=Qwen3-1.7B-GGUF

# Tavily as the only search provider (SearXNG would reach real search
# engines; this keeps the run fully offline after the model's first
# download), pointed at the stub instead of the real, paid Tavily.
COLLEGIUM_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=not-a-real-key
COLLEGIUM_TAVILY_BASE_URL=http://stubs:8080
# Moltbook discovery, pointed at the same stub instead of the real site.
COLLEGIUM_MOLTBOOK_BASE_URL=http://stubs:8080
# The publisher's stop switch: never post anywhere real from this stack.
COLLEGIUM_MOLTBOOK_PUBLISHING=off

# No opening-hours restriction, so a scripted smoke test can run any time.
COLLEGIUM_WORK_HOURS=always
COLLEGIUM_CONTACT=local-test@example.com

# For the CLI on the host, if you want it (containers use their own,
# set by compose.yaml itself, pointed at db:5432 inside the network).
COLLEGIUM_BOARD_DATABASE_URL=postgresql://collegium_board_app:localtest@localhost:55432/collegium
COLLEGIUM_WORKER_DATABASE_URL=postgresql://collegium_worker_app:localtest@localhost:55432/collegium

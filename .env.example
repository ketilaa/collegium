# Copy to .env. Compose reads it automatically; for the CLI on the host,
# export these (e.g. `set -a; . ./.env; set +a`).

# Search provider (provisioned and paid for by the owner).
TAVILY_API_KEY=
# The organization's own search (the searxng service), for the CLI on the host.
# Inside Compose the worker uses http://searxng:8080. When set, SearXNG is the
# default search and Tavily the paid fallback.
COLLEGIUM_SEARXNG_URL=http://localhost:8888

# Local model, OpenAI-compatible. From containers, the host is
# host.docker.internal. Give the model a large context, e.g. start Ollama
# with OLLAMA_CONTEXT_LENGTH=32768.
COLLEGIUM_LLM_MODEL=qwen3:14b

# Database passwords, required: Compose refuses to start without them.
# Choose your own, e.g. `openssl rand -hex 16` for each.
POSTGRES_PASSWORD=
COLLEGIUM_WORKER_PASSWORD=
COLLEGIUM_BOARD_PASSWORD=
COLLEGIUM_PUBLISHER_PASSWORD=

# The community agent on Moltbook. Only the publisher service is given the
# key; everything it sends was approved by the owner on the board.
# COLLEGIUM_MOLTBOOK_API_KEY=
# The stop switch: off stops all posting (default on in Compose).
# COLLEGIUM_MOLTBOOK_PUBLISHING=on

# CLI on the host.
COLLEGIUM_BOARD_DATABASE_URL=postgresql://collegium_board_app:${COLLEGIUM_BOARD_PASSWORD}@localhost:5432/collegium
COLLEGIUM_WORKER_DATABASE_URL=postgresql://collegium_worker_app:${COLLEGIUM_WORKER_PASSWORD}@localhost:5432/collegium
# COLLEGIUM_LLM_BASE_URL defaults to http://localhost:11434/v1 on the host and
# to host.docker.internal in containers; set it only to use another server.

# Who runs this copy of Collegium: a URL or mailto: address of yours, sent
# in the User-Agent of every request so a site owner can reach you. The
# software's own page is always sent too; it does not speak for your copy.
COLLEGIUM_CONTACT=
